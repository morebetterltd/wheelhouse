{
  "commander": {
    "role": "commander",
    "external": true,
    "runtime": "claude-code"
  },
  "seats": {
    "worker-1": {
      "role": "worker",
      "harness": "claude-code",
      "provider": "anthropic",
      "model": "claude-sonnet-5",
      "account": { "dir": "~/.pi-seats-myproject/worker-1", "label": "kk-personal-anthropic", "authRoute": "oauth" }
    },
    "worker-2": {
      "role": "worker",
      "harness": "codex",
      "provider": "openai-codex",
      "model": "gpt-5.5",
      "account": {
        "dir": "~/.pi-seats-myproject/worker-2",
        "label": "work-chatgpt-2",
        "authRoute": "oauth"
      }
    },
    "reviewer": {
      "role": "reviewer",
      "harness": "codex",
      "provider": "openai-codex",
      "model": "gpt-5.6-sol",
      "account": { "dir": "~/.pi-seats-myproject/reviewer", "authRoute": "oauth" }
    },
    "reviewer-shadow": {
      "role": "reviewer",
      "shadow": true,
      "harness": "claude-code",
      "provider": "anthropic",
      "model": "sonnet",
      "account": {
        "dir": "~/.pi-seats-myproject/reviewer-shadow",
        "authRoute": "oauth"
      },
      "allowedTools": "Bash(git status:*),Bash(bun test:*)"
    },
    "researcher": {
      "role": "researcher",
      "harness": "pi",
      "provider": "anthropic",
      "model": "claude-sonnet-5",
      "skills": [
        "~/.agents/skills/example-research-skill"
      ],
      "account": {
        "dir": "~/.pi-seats-myproject/researcher",
        "authRoute": "api_key"
      }
    }
  }
}
