.DS_Store

# seat runtime logs are per-machine noise, never product
seats/logs/

# seat runtime state and command FIFOs are per-machine, never product
seats/state.json
seats/staffing.json
seats/herald.state.json
seats/inbox.jsonl
seats/needs.jsonl
seats/intake.jsonl
seats/comms.jsonl
seats/inbox.cursor
seats/inbox.seen.json
seats/run/

# Task reports, graph exports and diagnostic captures belong on the bead,
# never in the public template, even after scrubbing. A forced add is caught
# by seats/no-tracked-evidence.selftest.sh (index and HEAD).
/evidence/

# Verdict files are working copies. Paste decisive output on the bead before
# citing it (wheelhouse/GRAPH.md, "Where evidence lives").
seats/verdicts/

# fleet runtime: seat worktrees and per-bead scratch are machine-local, never product
.wheelhouse-worktrees/
.wheelhouse-runs/
