RUN ["perl","-MPOSIX=setsid","-e","setsid or die; exec @ARGV or die","bash","seats/concurrency.selftest.sh"]

1. two seats, one roster — spawn, overlap, isolation, clean stop
  ok    hermetic: worker-a spawns
  ok    hermetic: worker-b spawns
  ok    hermetic: each seat has its OWN FIFO (worker-a.stdin, worker-b.stdin)
  ok    hermetic: bead-a dispatched to worker-a
  ok    hermetic: bead-b dispatched to worker-b (before bead-a's turn ended)
{"barrierObserved":true,"probes":[{"id":"49bb6f46-24c0-46a6-afa7-a34feb1aae9d","type":"response","command":"barrier_probe","success":true,"data":{"held":true}},{"id":"3b9b52f2-5cf4-4e9d-a2c1-2af682dd08e8","type":"response","command":"barrier_probe","success":true,"data":{"held":true}}],"releaseExists":false}
